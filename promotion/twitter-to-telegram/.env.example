# Twitter/X cookies (required for resource posts)
X_AUTH_TOKEN=
X_CT0=

# Telegram bot token (names must match config.json bot_token_env)
TELEGRAM_BOT_TOKEN=

# Telegram MTProto user API credentials (telegram_repost.py only).
# Create an app at https://my.telegram.org -> API development tools.
# A user session is required to read/search channel history (the Bot API cannot).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
