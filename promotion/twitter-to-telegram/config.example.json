{
  "downloads": {
    "dir": "./downloads",
    "keep_files": true
  },
  "run_state": {
    "path": "./state.json"
  },
  "resource": {
    "type": "csvfile",
    "url": "file://resources/resources.csv"
  },
  "twitter": {
    "auth_token_env": "X_AUTH_TOKEN",
    "ct0_env": "X_CT0"
  },
  "channels": {
    "shoss_en": {
      "enabled": true,
      "telegram": {
        "bot_token_env": "TELEGRAM_BOT_TOKEN_SHOSS_EN",
        "chat_id": -1001234567890
      },
      "posts": [
        {
          "text": "🔥 New on Shoss!",
          "image": "channels/shoss_en/assets/banner.png",
          "delete_previous": true
        },
        {
          "text": "Join the community 👇\n\n#dating #lgbtq",
          "delete_previous": false
        },
        {
          "resource": "media1",
          "text": "🎬 {url}",
          "delete_previous": true,
          "silent": false
        }
      ]
    },
    "shoss_media": {
      "enabled": true,
      "telegram": {
        "bot_token_env": "TELEGRAM_BOT_TOKEN_SHOSS_MEDIA",
        "chat_id": -1009876543210
      },
      "posts": [
        {
          "resource": "media2",
          "delete_previous": true,
          "silent": false
        }
      ]
    }
  }
}
